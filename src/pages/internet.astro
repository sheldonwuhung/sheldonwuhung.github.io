---
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import Projector from '../components/internet/Projector.astro';
import Monitor from '../components/internet/Monitor.astro';
import Laptop from '../components/internet/Laptop.astro';
---

<style>

    body {
        background-color: #ADB4FF;
        width: 100%;
        background-image: url('/projects/background/internet.svg');
        /* background-size: cover; */
        /* background-position: center top; */
        /* background-repeat: ; */
    }

    .greater-theory {
        font-family: 'Greater Theory';
        color: #242582;
    }

    .kode-mono {
        font-family: 'Kode Mono';
        color: #242582;
    }

    .kode-mono-purplewhite {
        font-family: 'Kode Mono';
        color: #D8DBFF;
    }

    .kode-mono-white {
        font-family: 'Kode Mono';
        color: #F7F7F7;
    }

    .poster-project-name {
        font-size: 1em;
    }

    .learn-more-button {
        font-size: 1.15em;
    }

    .badminton-hero {
        aspect-ratio: 1/1;
        object-fit: cover;
    }

     @media (min-width: 400) {
        .badminton-hero {
            aspect-ratio: 1.5/1;
            object-fit: cover;
        }
    }

    @media (min-width: 640px) {
        .poster-project-name {
            font-size: 1.15em;
        }
        .learn-more-button {
            font-size: 1.25em;
        }
        .badminton-hero {
            aspect-ratio: 2.75/1;
            object-fit: cover;
        }
    }

    @media (min-width: 800px) {
        .badminton-hero {
            aspect-ratio: auto;
            object-fit: fill;
        }
    }

    @media (min-width: 1280px) {
        .poster-project-name {
            font-size: 1.25em;
        }
        .learn-more-button {
            font-size: 1.35em;
        }
    }

    @media (min-width: 1536px) {
        .poster-project-name {
            font-size: 1.5em;
        }
        .learn-more-button {
            font-size: 1.6em;
        }
    }

    .badminton-hero-wrapper {
        position: relative;
        display: inline-block;
    }

    .badminton-hero-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(93, 94, 153, .75);
        pointer-events: none;
    }

    .img-wrapper {
        position: relative;
        display: inline-block;
    }

    .img-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(147,156,251,0);
        pointer-events: none;
        transition: background-color 0.2s ease;
    }

    .img-wrapper img:hover {
        rotate: 1deg;
        transition: rotate 0.2s ease;
        cursor: pointer;
    }

    .img-wrapper:hover::after {
        background: rgba(147,156,251,0);
        rotate: 1deg;
    }
    
    .drop-shadow-recs1 {
        box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.25);
    }

</style>

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sheldon Hung | Multimedia Digital Designer | Internet</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Turret+Road:wght@200;300;400;500;700;800&family=Zen+Dots&display=swap" rel="stylesheet">
    </head>
    <body id="body" class="">
        <Nav></Nav>
        <div class="first grid">
            <div class="flex flex-col justify-center text-center mt-[1%]">
                <span class="greater-theory my-[.25%] text-[1.5em] sm:text-[2em] xl:text-[3em] 2xl:text-[4em]">INTERNET</span>
                <span class="greater-theory my-[.25%] text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] drop-shadow-xl">WEBSITES</span>
                
                <div class="grid place-items-center mt-[5%] sm:flex sm:justify-center sm:items-center">
                    <a class="img-wrapper w-[80%] sm:w-[50%]" target="_blank" href="/internet/datathon">
                        <Projector></Projector>
                    </a>

                    <div class="w-[80%] sm:w-[30%] text-center mb-[1%] p-[2%] grid place-items-center">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            Lost in Transit
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" href="/internet/datathon">
                            Learn More
                        </a>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" target="_blank" href="https://sheldonwuhung.github.io/Lost-In-Transit/">
                            Website
                        </a>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" target="_blank" href="https://macaulay.cuny.edu/news-and-events/students-tackle-traffic-congestion-in-2025-datathon/">
                            Article
                        </a>    
                    </div>
                </div>

                <div class="grid place-items-center mt-[5%] sm:flex sm:justify-center sm:items-center">
                    <a class="block sm:hidden img-wrapper w-[75%] sm:w-0" target="_blank" href="/internet/music">
                        <Monitor></Monitor>
                    </a>
                    <div class="w-[80%] sm:w-[30%] text-center mb-[1%] p-[2%] grid place-items-center">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            Music Portfolio
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" href="/internet/music">
                            Learn More
                        </a>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" target="_blank" href="https://sheldonwuhung.github.io/music/">
                            Website
                        </a>    
                    </div>
                    <a class="hidden sm:block img-wrapper sm:w-[40%]" target="_blank" href="/internet/music">
                        <Monitor></Monitor>
                    </a>
                    
                </div>

                <span class="greater-theory my-[.25%] text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] mt-[5%] drop-shadow-xl">PROTOTYPES</span>

                <div class="grid place-items-center my-[5%] sm:flex sm:justify-center sm:items-center">

                    <a class="img-wrapper w-[80%] sm:w-[50%]" target="_blank" href="/internet/orv">
                        <Laptop></Laptop>
                    </a>

                    <div class="w-[80%] sm:w-[30%] text-center mb-[1%] p-[2%] grid place-items-center">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            Omniscient Reader's Viewpoint Fanpage
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" href="/internet/orv">
                            Learn More
                        </a>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" target="_blank" href="https://www.figma.com/proto/Q7w533ZG1Uyz4XsyXIXS5F/Sheldon-Hung_Fan-Page?node-id=241-25076&p=f&viewport=118%2C-411%2C0.16&t=CkoJxJAMjHm7TZVP-1&scaling=scale-down&content-scaling=responsive&starting-point-node-id=241%3A25076&page-id=218%3A53">
                            Figma Link
                        </a>
                    </div>
                </div>

                    
            </div>
        </div>   
    </body>

</html>


