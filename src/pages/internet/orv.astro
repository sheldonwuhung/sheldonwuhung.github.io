---
import '../../styles/global.css';
import Nav from '../../components/nav/Nav.astro';
import Sitemap from '../../components/internet/ORVSitemap.astro';
import Wireframe from '../../components/internet/ORVWireframe.astro';

---

<style>

    body {
        background-color: #ADB4FF;
        width: 100%;
        background-image: url('/projects/background/internet.svg');
    }

    .greater-theory {
        font-family: 'Greater Theory';
        color: #242582;
    }

    .kode-mono {
        font-family: 'Kode Mono';
        color: #242582;
    }

    .kode-mono-purplewhite {
        font-family: 'Kode Mono';
        color: #D8DBFF;
    }

    .kode-mono-white {
        font-family: 'Kode Mono';
        color: #F7F7F7;
    }

    .inter-white {
        font-family: 'Inter';
        color: #F7F7F7;
    }

    .inria-serif-white {
        font-family: 'Inria Serif';
        color: #F7F7F7;
    }

    .boruna-white {
        font-family: 'Boruna';
        color: #F7F7F7;
    }

    .bumerang-white {
        font-family: 'Bumerang';
        color: #F7F7F7;
    }

    .te-quirtez-white {
        font-family: 'Te Quirtez';
        color: #F7F7F7;
    }

    .poster-project-name {
        font-size: 1em;
    }

    .learn-more-button {
        font-size: 1.15em;
    }

    .badminton-hero {
        aspect-ratio: 1/1;
        object-fit: cover;
    }

     @media (min-width: 400) {
        .badminton-hero {
            aspect-ratio: 1.5/1;
            object-fit: cover;
        }
    }

    @media (min-width: 640px) {
        .poster-project-name {
            font-size: 1.15em;
        }
        .learn-more-button {
            font-size: 1.25em;
        }
        .badminton-hero {
            aspect-ratio: 2.75/1;
            object-fit: cover;
        }
    }

    @media (min-width: 800px) {
        .badminton-hero {
            aspect-ratio: auto;
            object-fit: fill;
        }
    }

    @media (min-width: 1280px) {
        .poster-project-name {
            font-size: 1.25em;
        }
        .learn-more-button {
            font-size: 1.35em;
        }
    }

    @media (min-width: 1536px) {
        .poster-project-name {
            font-size: 1.5em;
        }
        .learn-more-button {
            font-size: 1.6em;
        }
    }

    .badminton-hero-wrapper {
        position: relative;
        display: inline-block;
    }

    .badminton-hero-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(93, 100, 185, .25);
        pointer-events: none;
    }

    .img-wrapper {
        position: relative;
        display: inline-block;
    }

    .img-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(147,156,251,0);
        pointer-events: none;
        transition: background-color 0.2s ease;
    }

    .img-wrapper img:hover {
        rotate: 1deg;
        transition: rotate 0.2s ease;
        cursor: pointer;
    }

    .img-wrapper:hover::after {
        background: rgba(147,156,251,0);
        rotate: 1deg;
    }
    
    .drop-shadow-recs1 {
        box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.25);
    }

</style>

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sheldon Hung | Multimedia Digital Designer | Omniscient Reader's Viewpoint Fanpage</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Turret+Road:wght@200;300;400;500;700;800&family=Zen+Dots&display=swap" rel="stylesheet">
    </head>
    <body id="body" class="">
        <Nav></Nav>
        <div class="first grid">
            <div class="flex flex-col justify-center text-center">
                <span class="greater-theory text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] drop-shadow-xl">
                    Omniscient Reader's Viewpoint Fanpage
                </span>

                <div class="badminton-hero-wrapper">
                    <video class="element-bottom aspect-9/16 sm:aspect-video block sm:hidden sm:w-0 sm:h-0 w-full h-full badminton-hero drop-shadow-recs1" autoplay muted loop playsinline width="100%">
                        <source src="/projects/internet/orv.mp4" type="video/mp4">
                    </video>
                    <img src="/projects/hero/orv.webp" class="hidden sm:block badminton-hero drop-shadow-recs1">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2">
                    <video class="element-bottom aspect-9/16 sm:aspect-video hidden sm:block sm:w-full sm:h-full" autoplay muted loop playsinline width="100%">
                        <source src="/projects/internet/orv.mp4" type="video/mp4">
                    </video>
                    <div class="w-full flex justify-center py-[7.5%]">
                        <div class="w-[70%] grid place-items-center">
                            <span class="kode-mono w-full text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                                A Reader's Fantasy
                            </span>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] mb-[2.5%]">
                                A fan page describing the novelty of Omniscient Reader’s Viewpoint. 
                                Sections and animation imitates the movement of flipping a page in a book.
                            </p>

                            <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" target="_blank" href="https://www.figma.com/proto/Q7w533ZG1Uyz4XsyXIXS5F/Sheldon-Hung_Fan-Page?node-id=241-25076&p=f&viewport=118%2C-411%2C0.16&t=CkoJxJAMjHm7TZVP-1&scaling=scale-down&content-scaling=responsive&starting-point-node-id=241%3A25076&page-id=218%3A53">
                                Figma Link
                            </a>   
                        </div>
                    </div>
                </div>

                <div class="grid sm:grid-cols-3 place-items-center bg-[rgba(93,94,153,.53)]">
                    <div class="w-full flex justify-center py-[7.5%]">
                        <div class="w-full grid place-items-center sm:pl-[15%]">
                            <span class="kode-mono-white w-full text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                                Design
                            </span>
                            <p class="kode-mono-white text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] sm:mb-[2.5%]">
                                Elegant type to complement a beautiful and non-classical story. 
                                Monotone colors with an accent of gold to reflect valuable life lessons.
                            </p>
                        </div>
                    </div>
                    <div class="w-full flex justify-center sm:my-[5%]">
                        <div class="sm:w-[90%] grid grid-cols-2 items-center">
                            <div class="w-[75%] justify-center sm:justify-end text-start grid items-end inter-white text-[1.3em] sm:text-[1.5em] md:text-[1.8em] xl:text-[2em] 2xl:text-[2.2em]">
                                <span class="flex justify-start mb-[2.5%] mr-[5%]">
                                    H1
                                </span>
                                <span class="flex justify-start mb-[2.5%] mr-[5%]">
                                    H2
                                </span>
                                <span class="flex justify-start mb-[2.5%] mr-[5%]">
                                    H3
                                </span>
                                <span class="flex justify-start mb-[2.5%] mr-[5%]">
                                    P
                                </span>
                            </div>
                            <div class="grid items-center text-start text-[1.3em] sm:text-[1.5em] md:text-[1.8em] xl:text-[2em] 2xl:text-[2.2em]">
                                <span class="te-quirtez-white mb-[2.5%]">
                                    Te Quirtez
                                </span>
                                <span class="boruna-white mb-[2.5%]">
                                    Boruna
                                </span>
                                <span class="bumerang-white mb-[2.5%]">
                                    Bumerang
                                </span>
                                <span class="inria-serif-white mb-[2.5%]">
                                    Inria Serif
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="w-full flex justify-center py-[7.5%]">
                        <div class="w-[70%] grid grid-cols-2 place-items-center mx-[12.5%]">
                            <div class="bg-[rgb(0,0,0)] w-[90%] mb-[5%] aspect-square"></div>
                            <div class="bg-[rgb(255,245,210)] w-[90%] mb-[5%] aspect-square"></div>
                            <div class="bg-[rgb(255,255,255)] w-[90%] mb-[5%] aspect-square"></div>
                            <div class="bg-[rgb(54,54,54)] w-[90%] mb-[5%] aspect-square"></div>
                        </div>
                    </div>
                    
                </div>
                
            </div>

        </div> 
        
        <div class="grid sm:grid-cols-2 place-items-center sm:flex sm:justify-center sm:items-center">
            <div class="sm:hidden w-[80%] grid sm:w-[50%] text-center mb-[1%] sm:pr-[8%] py-[8%]">
                <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                    Sitemap
                </span>
                <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] mb-[2.5%]">
                    Planning of what types of pages there will be and what pages the user will see.
                </p>
            </div>
            <div class="w-full sm:w-[50%] flex justify-center pb-[8%] sm:pb-[0%]">    
                <div class="w-[90%] sm:w-[60%]">
                    <Sitemap></Sitemap>
                </div>
            </div>
            <div class="hidden sm:grid sm:w-[50%] text-center mb-[1%] sm:pr-[8%] py-[8%]">
                <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                    Sitemap
                </span>
                <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] mb-[2.5%]">
                    Planning of what types of pages there will be and what pages the user will see.
                </p>
            </div>
        </div>

        <div class="bg-[rgba(93,94,153,.53)] grid sm:grid-cols-2 place-items-center sm:flex sm:justify-center sm:items-center">
            <div class="w-[80%] sm:w-[50%] text-center mb-[1%] sm:pl-[8%] py-[8%]">
                <span class="kode-mono-white text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                    Wireframe
                </span>
                <p class="kode-mono-white text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] mb-[2.5%]">
                    Simple book and page format with bookmarks to indicate the types of pages there are.
                </p>
            </div>

            <div class="w-full sm:w-[50%] flex justify-center pb-[8%] sm:pb-[0%]">    
                <div class="w-[90%] sm:w-[60%]">
                    <Wireframe></Wireframe>
                </div>
            </div>
        </div>
        
    </body>

</html>


