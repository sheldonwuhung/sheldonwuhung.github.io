---
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import Pin from '../components/posters/Pin.astro';
import InstagramSVG from '../components/posters/Instagram.astro';

---

<style>

    body {
        background-color: #ADB4FF;
        width: 100%;
        background-image: url('/projects/background/posters.svg');
    }

    .greater-theory {
        font-family: 'Greater Theory';
        color: #242582;
    }

    .kode-mono {
        font-family: 'Kode Mono';
        color: #242582;
    }

    .poster-project-name {
        font-size: 1em;
    }

    .learn-more-button {
        font-size: 1.15em;
    }

    @media (min-width: 640px) {
        .poster-project-name {
            font-size: 1.15em;
        }
        .learn-more-button {
            font-size: 1.25em;
        }
    }

    @media (min-width: 1280px) {
        .poster-project-name {
            font-size: 1.25em;
        }
        .learn-more-button {
            font-size: 1.35em;
        }
    }

    @media (min-width: 1536px) {
        .poster-project-name {
            font-size: 1.5em;
        }
        .learn-more-button {
            font-size: 1.6em;
        }
    }

    .img-wrapper {
        position: relative;
        display: inline-block;
    }

    .img-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(147,156,251,0.15);
        pointer-events: none;
        transition: background-color 0.2s ease;
    }

    .img-wrapper img:hover {
        rotate: 1deg;
        transition: rotate 0.2s ease;
        cursor: pointer;
    }

    .img-wrapper:hover::after {
        background: rgba(147,156,251,0);
        rotate: 1deg;
    }

    /* #b1img, #b2img, #b3img, #b4img, #e1img, #e2img {
        rotate: 0deg;
    }

    #b1img:hover, #b2img:hover, #b3img:hover, #b4img:hover, #e1img:hover, #e2img:hover {
        rotate: 1deg;
        /* filter: brightness(0) saturate(100%) invert(54%) sepia(96%) saturate(442%) hue-rotate(199deg) brightness(102%) contrast(97%) opacity(50%); 
    } 
    */
    


</style>

