---
import '../../styles/global.css';
import Nav from '../../components/nav/Nav.astro';
import KC from '../../components/3dmodels/TheKnightCloaked.astro'
import UC from '../../components/3dmodels/TheKnightUncloaked.astro'
import Bench from '../../components/3dmodels/Bench.astro'
import Nail from '../../components/3dmodels/Nail.astro'

---

<style>

    body {
        background-color: #ADB4FF;
        width: 100%;
        background-image: url('/projects/background/modelsplain.svg');
    }

    .greater-theory {
        font-family: 'Greater Theory';
        color: #242582;
    }

    .kode-mono {
        font-family: 'Kode Mono';
        color: #242582;
    }

    .kode-mono-purplewhite {
        font-family: 'Kode Mono';
        color: #D8DBFF;
    }

    .kode-mono-white {
        font-family: 'Kode Mono';
        color: #F7F7F7;
    }

    .poster-project-name {
        font-size: 1em;
    }

    .learn-more-button {
        font-size: 1.15em;
    }

    .badminton-hero {
        aspect-ratio: 1/1;
        object-fit: cover;
    }

     @media (min-width: 400) {
        .badminton-hero {
            aspect-ratio: 1.5/1;
            object-fit: cover;
        }
    }

    @media (min-width: 640px) {
        .poster-project-name {
            font-size: 1.15em;
        }
        .learn-more-button {
            font-size: 1.25em;
        }
        .badminton-hero {
            aspect-ratio: 2.75/1;
            object-fit: cover;
        }
    }

    @media (min-width: 800px) {
        .badminton-hero {
            aspect-ratio: auto;
            object-fit: fill;
        }
    }

    @media (min-width: 1280px) {
        .poster-project-name {
            font-size: 1.25em;
        }
        .learn-more-button {
            font-size: 1.35em;
        }
    }

    @media (min-width: 1536px) {
        .poster-project-name {
            font-size: 1.5em;
        }
        .learn-more-button {
            font-size: 1.6em;
        }
    }

    .badminton-hero-wrapper {
        position: relative;
        display: inline-block;
    }

    .badminton-hero-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(93, 94, 153, .75);
        pointer-events: none;
    }

    .img-wrapper {
        position: relative;
        display: inline-block;
    }

    .img-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(147,156,251,0);
        pointer-events: none;
        transition: background-color 0.2s ease;
    }

    .img-wrapper img:hover {
        rotate: 1deg;
        transition: rotate 0.2s ease;
        cursor: pointer;
    }

    .img-wrapper:hover::after {
        background: rgba(147,156,251,0);
        rotate: 1deg;
    }
    
    .drop-shadow-recs1 {
        box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.25);
    }

</style>

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sheldon Hung | Multimedia Digital Designer | The Knight</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Turret+Road:wght@200;300;400;500;700;800&family=Zen+Dots&display=swap" rel="stylesheet">
    </head>
    <body id="body" class="">
        <Nav></Nav>
        <div class="first grid">
            <div class="flex flex-col justify-center text-center">
                <span class="greater-theory text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] drop-shadow-xl">
                    The Knight
                </span>

                <div class="grid">
                    <img src="/projects/hero/theknighth.webp" class="badminton-hero drop-shadow-recs1">
                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] pt-[2%]">
                        Cartoonish Modeling
                    </span>
                    <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] px-[10%] pt-[1%] pb-[3%]">
                        A 3D model creation of "The Knight" resting on a bench with their nail on the side. Focus on simple and soft features.
                    </p>
                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] pt-[2%]">
                        Character Models
                    </span>
                    <div class="flex overflow-x-auto bg-[rgba(93,100,185,.3)] w-[170%] sm:w-[100%]">
                        <div class="shrink-0 w-[40%]">
                            <div class="grid place-items-center">
                                <div class="w-full">
                                    <KC></KC>
                                </div>
                                <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                    Knight Cloaked
                                </p>
                            </div>
                        </div>
                        <div class="shrink-0 w-[40%]">
                            <div class="grid place-items-center">
                                <div class="w-[76.1%]">
                                    <UC></UC>
                                </div>
                                <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                    Knight Uncloaked
                                </p>
                            </div>
                        </div>
                        <div class="shrink-0 w-[40%]">
                            <div class="grid place-items-center">
                                <div class="w-[66.5%]">
                                    <img src="/projects/3dmodels/tkr1.webp">
                                </div>
                                <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                    Character Reference
                                </p>
                            </div>
                        </div>
                        <div class="shrink-0 w-[42%] place-items-end">
                            <div class="grid place-items-center items-center">
                                <div class="w-[114%]">
                                    <img src="/projects/3dmodels/tkr2.webp">
                                </div>
                                <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                    Bench Reference
                                </p>
                            </div>
                        </div>
                    </div>
                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] pt-[2%]">
                        Props
                    </span>
                    <div class="grid sm:grid-cols-2 place-items-center justify-center pl-[7%] pb-[3%]">
                        <div class="w-[500%] sm:w-[95%]">
                            <div class="w-[100%]">
                               <Bench></Bench> 
                            </div>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                Bench
                            </p>
                        </div>
                        <div class="w-[500%] sm:w-[95%] translate-y-[-7%]">
                            <div class="w-[100%]">
                               <Nail></Nail> 
                            </div>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                Nail
                            </p>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>   
    </body>

</html>


