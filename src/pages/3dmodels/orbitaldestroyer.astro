---
import '../../styles/global.css';
import Nav from '../../components/nav/Nav.astro';
import OD1 from '../../components/3dmodels/OrbitalDestroyerD1.astro'
---

<style>

    body {
        background-color: #ADB4FF;
        width: 100%;
        background-image: url('/projects/background/modelsplain.svg');
    }

    .greater-theory {
        font-family: 'Greater Theory';
        color: #242582;
    }

    .kode-mono {
        font-family: 'Kode Mono';
        color: #242582;
    }

    .kode-mono-purplewhite {
        font-family: 'Kode Mono';
        color: #D8DBFF;
    }

    .kode-mono-white {
        font-family: 'Kode Mono';
        color: #F7F7F7;
    }

    .poster-project-name {
        font-size: 1em;
    }

    .learn-more-button {
        font-size: 1.15em;
    }

    .badminton-hero {
        aspect-ratio: 1/1;
        object-fit: cover;
    }

     @media (min-width: 400) {
        .badminton-hero {
            aspect-ratio: 1.5/1;
            object-fit: cover;
        }
    }

    @media (min-width: 640px) {
        .poster-project-name {
            font-size: 1.15em;
        }
        .learn-more-button {
            font-size: 1.25em;
        }
        .badminton-hero {
            aspect-ratio: 2.75/1;
            object-fit: cover;
        }
    }

    @media (min-width: 800px) {
        .badminton-hero {
            aspect-ratio: auto;
            object-fit: fill;
        }
    }

    @media (min-width: 1280px) {
        .poster-project-name {
            font-size: 1.25em;
        }
        .learn-more-button {
            font-size: 1.35em;
        }
    }

    @media (min-width: 1536px) {
        .poster-project-name {
            font-size: 1.5em;
        }
        .learn-more-button {
            font-size: 1.6em;
        }
    }

    .badminton-hero-wrapper {
        position: relative;
        display: inline-block;
    }

    .badminton-hero-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(93, 94, 153, .75);
        pointer-events: none;
    }

    .img-wrapper {
        position: relative;
        display: inline-block;
    }

    .img-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(147,156,251,0);
        pointer-events: none;
        transition: background-color 0.2s ease;
    }

    .img-wrapper img:hover {
        rotate: 1deg;
        transition: rotate 0.2s ease;
        cursor: pointer;
    }

    .img-wrapper:hover::after {
        background: rgba(147,156,251,0);
        rotate: 1deg;
    }
    
    .drop-shadow-recs1 {
        box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.25);
    }

</style>

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sheldon Hung | Multimedia Digital Designer | Orbital Destroyer</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Turret+Road:wght@200;300;400;500;700;800&family=Zen+Dots&display=swap" rel="stylesheet">
    </head>
    <body id="body" class="">
        <Nav></Nav>
        <div class="first grid">
            <div class="flex flex-col justify-center text-center">
                <span class="greater-theory text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] drop-shadow-xl">
                    Orbital Destroyer
                </span>

                <div class="grid place-items-center">
                    <img src="/projects/hero/orbitaldestroyerh.webp" class="badminton-hero drop-shadow-recs1">
                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] pt-[2%]">
                        Vehicular Modeling
                    </span>
                    <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] px-[10%] pt-[1%] pb-[3%]">
                        A 3D model and environment featuring a military spacecraft. Focus on external functionality and practical use. 
                    </p>

                    <div class="w-[100%]">
                        <OD1></OD1>
                    </div>

                    <div class="grid sm:grid-cols-2 place-items-center">
                        <div class="w-[60%]">
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] px-[10%] pt-[1%] pb-[3%]">
                                Bottom View 
                            </p>
                            <img src="/projects/3dmodels/odd2.webp">
                        </div>
                        <div class="w-[60%]">
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] px-[10%] pt-[1%] pb-[3%]">
                                Top View 
                            </p>
                            <img src="/projects/3dmodels/odd3.webp">
                        </div>
                    </div>

                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] pt-[2%]">
                        Cannons
                    </span>
                    <div class="grid sm:grid-cols-2 place-items-center justify-center px-[10%] pb-[3%]">
                        <div class="w-[80%] sm:w-[95%]">
                            <div class="w-[100%]">
                               <img src="/projects/3dmodels/odc1.webp">
                            </div>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                Single
                            </p>
                        </div>
                        <div class="w-[80%] sm:w-[95%]">
                            <div class="w-[100%]">
                               <img src="/projects/3dmodels/odc2.webp">
                            </div>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                Triple
                            </p>
                        </div>
                        <div class="w-[80%] sm:w-[95%]">
                            <div class="w-[100%]">
                               <img src="/projects/3dmodels/odc3.webp">
                            </div>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                Gatling
                            </p>
                        </div>
                        <div class="w-[80%] sm:w-[95%]">
                            <div class="w-[100%]">
                               <img src="/projects/3dmodels/odc4.webp">
                            </div>
                            <p class="kode-mono text-[.9em] sm:text-[.95em] md:text-[1em] xl:text-[1.35em] 2xl:text-[1.75em] my-[2.5%]">
                                Laser
                            </p>
                        </div>
                    </div>

                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] pt-[2%]">
                        References
                    </span>

                    <div class="grid sm:grid-cols-2 place-items-center justify-center px-[10%] py-[3%]">
                        <div class="w-[80%] sm:w-[95%]">
                            <div class="w-[100%] drop-shadow-recs1">
                               <img src="/projects/3dmodels/odr1.webp">
                            </div>
                        </div>
                        <div class="w-[80%] sm:w-[95%]">
                            <div class="w-[100%] drop-shadow-recs1">
                               <img src="/projects/3dmodels/odr2.webp">
                            </div>
                        </div>
                    </div>
                    
                </div>
                
            </div>
        </div>   
    </body>

</html>


