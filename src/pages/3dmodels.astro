---
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import LibraryImage from '../components/3dmodels/LibraryImage.astro';
import BadmintonClub from '../components/3dmodels/BCBC.astro';
---

<style>

    body {
        background-color: #ADB4FF;
        width: 100%;
        background-image: url('/projects/background/3dmodels.svg');
        /* background-size: cover; */
        /* background-position: center top; */
        /* background-repeat: ; */
    }

    .greater-theory {
        font-family: 'Greater Theory';
        color: #242582;
    }

    .kode-mono {
        font-family: 'Kode Mono';
        color: #242582;
    }

    .kode-mono-purplewhite {
        font-family: 'Kode Mono';
        color: #D8DBFF;
    }

    .kode-mono-white {
        font-family: 'Kode Mono';
        color: #F7F7F7;
    }

    .poster-project-name {
        font-size: 1em;
    }

    .learn-more-button {
        font-size: 1.15em;
    }

    .badminton-hero {
        aspect-ratio: 1/1;
        object-fit: cover;
    }

     @media (min-width: 400) {
        .badminton-hero {
            aspect-ratio: 1.5/1;
            object-fit: cover;
        }
    }

    @media (min-width: 640px) {
        .poster-project-name {
            font-size: 1.15em;
        }
        .learn-more-button {
            font-size: 1.25em;
        }
        .badminton-hero {
            aspect-ratio: 2.75/1;
            object-fit: cover;
        }
    }

    @media (min-width: 800px) {
        .badminton-hero {
            aspect-ratio: auto;
            object-fit: fill;
        }
    }

    @media (min-width: 1280px) {
        .poster-project-name {
            font-size: 1.25em;
        }
        .learn-more-button {
            font-size: 1.35em;
        }
    }

    @media (min-width: 1536px) {
        .poster-project-name {
            font-size: 1.5em;
        }
        .learn-more-button {
            font-size: 1.6em;
        }
    }

    .badminton-hero-wrapper {
        position: relative;
        display: inline-block;
    }

    .badminton-hero-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(93, 94, 153, .75);
        pointer-events: none;
    }

    .img-wrapper {
        position: relative;
        display: inline-block;
    }

    .img-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(147,156,251,0);
        pointer-events: none;
        transition: background-color 0.2s ease;
    }

    .img-wrapper img:hover {
        rotate: 1deg;
        transition: rotate 0.2s ease;
        cursor: pointer;
    }

    .img-wrapper:hover::after {
        background: rgba(147,156,251,0);
        rotate: 1deg;
    }
    
    .drop-shadow-recs1 {
        box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.25);
    }

</style>

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sheldon Hung | Multimedia Digital Designer | 3D Models</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Turret+Road:wght@200;300;400;500;700;800&family=Zen+Dots&display=swap" rel="stylesheet">
    </head>
    <body id="body" class="">
        <Nav></Nav>
        <div class="first grid">
            <div class="flex flex-col justify-center text-center mt-[1%]">
                <span class="greater-theory my-[.25%] text-[1.5em] sm:text-[2em] xl:text-[3em] 2xl:text-[4em]">3D MODELING</span>
                <span class="greater-theory my-[.25%] text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] drop-shadow-xl">INTERIOR ENVIRONMENTS</span>
                
                <div class="grid grid-cols-1 place-items-center mt-[2%] sm:justify-center sm:items-center">
                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                        Victorian Library
                    </span>
                    <a class="img-wrapper w-[80%] sm:w-[80%]" href="/3dmodels/library">
                        <LibraryImage></LibraryImage>
                    </a>

                    <div class="w-[80%] sm:w-[30%] text-center mb-[2.5%] px-[2%] grid place-items-center">
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" href="/3dmodels/library">
                            Learn More
                        </a>
                    </div>
                </div>

                <div class="grid grid-cols-1 place-items-center mt-[0%] sm:justify-center sm:items-center">
                    <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                        Brooklyn College Badminton Club
                    </span>
                    <a class="img-wrapper w-[80%] sm:w-[80%]" href="/3dmodels/bcbc">
                        <BadmintonClub></BadmintonClub>
                    </a>

                    <div class="w-[80%] sm:w-[30%] text-center mb-[2.5%] px-[2%] grid sm:flex sm:gap-[10%] place-items-center">
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" href="/3dmodels/bcbc">
                            Learn More
                        </a>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[50%] my-[2.5%] py-[1%] learn-more-button" target="_blank" href="https://www.roblox.com/games/106171116241664/Badminton-Gym">
                            Game Link
                        </a>
                    </div>
                </div>

                <span class="greater-theory my-[.25%] text=[.75em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em] bg-[rgba(147,156,251,.75)] drop-shadow-xl">MODELS</span>
                
                
                <div class="grid sm:grid-cols-2 place-items-center mt-[2%] sm:mt-[7.5%] sm:justify-center sm:items-center">
                    <a class="img-wrapper w-[80%] sm:w-[100%] sm:pl-[15%]" href="/3dmodels/theknight">
                        <img src="/projects/3dmodels/theknight.webp">
                    </a>

                    <div class="w-[80%] sm:w-[60%] text-center mb-[2.5%] px-[2%] grid place-items-center sm:justify-start">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            The Knight
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[100%] my-[2.5%] py-[1%] learn-more-button" href="/3dmodels/theknight">
                            Learn More
                        </a>
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 place-items-center mt-[7.5%] sm:justify-center sm:items-center">
                    <div class="hidden sm:grid w-[80%] sm:w-[20%] text-center mb-[2.5%] px-[2%] place-items-center sm:justify-end">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            Orbital Destroyer
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[100%] my-[2.5%] py-[1%] learn-more-button" href="/3dmodels/orbitaldestroyer">
                            Learn More
                        </a>
                    </div>
                    <a class="img-wrapper w-[80%] sm:w-[125%] sm:mr-[60%]" target="_blank" href="/3dmodels/orbitaldestroyer">
                        <img src="/projects/3dmodels/od.webp">
                    </a>
                    <div class="grid sm:hidden w-[80%] sm:w-[20%] text-center mb-[2.5%] px-[2%] place-items-center sm:justify-end">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            Orbital Destroyer
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[100%] my-[2.5%] py-[1%] learn-more-button" href="/3dmodels/orbitaldestroyer">
                            Learn More
                        </a>
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 place-items-center mt-[7.5%] sm:mt-[0%] sm:justify-center sm:items-center">
                    <a class="img-wrapper w-[80%] sm:w-[100%] sm:pl-[15%]" target="_blank" href="/3dmodels/badmintonrackets">
                        <img src="/projects/3dmodels/rackets.webp">
                    </a>

                    <div class="w-[80%] sm:w-[80%] text-center mb-[2.5%] px-[2%] grid place-items-center sm:justify-start">
                        <span class="kode-mono text-[1em] sm:text-[1.25em] xl:text-[1.75em] 2xl:text-[2.6em]">
                            Badminton Rackets
                        </span>
                        <a class="kode-mono cut-corners bg-[rgba(147,156,251,.72)] w-[80%] sm:w-[60%] my-[2.5%] py-[1%] learn-more-button" href="/3dmodels/badmintonrackets">
                            Learn More
                        </a>
                    </div>
                </div>
                    
            </div>
        </div>   
    </body>

</html>


