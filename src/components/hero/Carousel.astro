---
import Logo from '../logo/Logo.astro';
---

<style>

    @media screen and (min-width: 2156){
        .element-top {
            font-size: 3em;
            text-shadow: 2px 2.9px 0px #939CFB;
        }
    }

    @media screen and (min-width: 1920px) and (max-width: 2155px) {
        .element-top {
            font-size: 2.65em;
            text-shadow: 1.5px 2.1px 0px #939CFB;
        }
    }

    @media screen and (min-width: 1600px) and (max-width: 1919px) {
        .element-top {
            font-size: 2.25em;
            text-shadow: 1.1px 1.7px 0px #939CFB;
        }
    }

    @media screen and (min-width: 1280px) and (max-width: 1599px) {
        .element-top {
            font-size: xx-large;
            text-shadow: .85px 1.4px 0px #939CFB;
        }
    }

    @media screen and (min-width: 768px) and (max-width: 1279px) {
        .element-top {
            font-size: x-large;
            text-shadow: .5px 1px 0px #939CFB;
        }
    }

    @media screen and (min-width: 530px) and (max-width: 767px) {
        .element-top {
            font-size: large;
            text-shadow: .35px .75px 0px #939CFB;
        }
    }

    @media screen and (min-width: 480px) and (max-width: 529px) {
        .element-top {
            font-size: medium;
            text-shadow: .25px .65px 0px #939CFB;
        }
    }

    @media screen and (max-width: 479px) {
        .element-top {
            font-size: small;
            text-shadow: .1px .5px 0px #939CFB;
        }
    }

    .grid-container {
        width: 100vw;
        display: grid;
    }

    .element-bottom, .element-top {
        grid-area: 1 / 1;
    }

    .element-bottom {
        width: 100%;
        height: 100vh;
        object-fit: cover;
    }

    .element-bottom[hidden] {
        display: none;
    }

    .element-top {
        /* align-self: center;
        justify-self: center;  */
        z-index: 2; 
        font-family: 'Greater Theory';
        color: #242582;
        margin-top: -1%;
    }

</style>

<div class="grid-container" data-hero-carousel>
    <video
        class="element-bottom aspect-9/16 sm:aspect-video"
        src="/projects/hero/help(1).mp4"
        autoplay
        muted
        loop
        playsinline
        width="100%"
    ></video>

    <img
        class="element-bottom aspect-9/16 sm:aspect-video"
        src="/projects/hero/posters.webp"
        alt="Badminton game"
        hidden
    >

    <!-- <span class="p-[1em] element-top">
        MULTIMEDIA DIGITAL DESIGNER/DEVELOPER VERSED IN A MULTITUDE OF CREATIVE FIELDS
    </span> -->
</div>

<script>
    const slides: { src: string; type: 'image' | 'video'; alt?: string }[] = [
        { src: '/projects/hero/help(1).mp4', type: 'video' },
        { src: '/projects/hero/1.mp4', type: 'video' },
        { src: '/projects/hero/posters.webp', type: 'image', alt: 'posters' },
        // { src: '/projects/hero/badminton1.webp', type: 'image', alt: 'Badminton game' },
        { src: '/projects/posters/heike/suits.webp', type: 'image', alt: 'suits' },
        { src: '/projects/posters/heike/lookswelove.webp', type: 'image', alt: 'lookswelove' },
        { src: '/projects/3dmodels/bcbc1.webp', type: 'image', alt: 'david' },
        // { src: '/projects/hero/baruchesa1.webp', type: 'image', alt: 'Baruch event' },
        // { src: '/projects/hero/bcbch.webp', type: 'image', alt: 'badminton desk' },
        // { src: '/projects/hero/datathon.webp', type: 'image', alt: 'Datathon presentation' },
        // { src: '/projects/hero/libraryh.webp', type: 'image', alt: 'Library environment model' },
        // { src: '/projects/hero/music.webp', type: 'image', alt: 'Music page design' },
        // { src: '/projects/hero/orbitaldestroyerh.webp', type: 'image', alt: 'Orbital Destroyer project' },
        { src: '/projects/hero/orv.webp', type: 'image', alt: 'orv' },
        { src: '/projects/hero/theknighth.webp', type: 'image', alt: 'the knight' },
    ];

    const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
    const video = carousel?.querySelector<HTMLVideoElement>('video');
    const image = carousel?.querySelector<HTMLImageElement>('img');

    if (!video || !image) {
        throw new Error('Hero carousel is missing its video or image element.');
    }

    let currentIndex = 0;

    function showSlide(index: number) {
        const slide = slides[index];

        if (slide.type === 'video') {
            image.hidden = true;
            video.hidden = false;

            if (video.getAttribute('src') !== slide.src) {
                video.src = slide.src;
                video.load();
            }

            void video.play().catch((error: unknown) => {
                console.error('Unable to play hero carousel video:', error);
            });
        } else {
            video.pause();
            video.hidden = true;
            image.src = slide.src;
            image.alt = slide.alt ?? '';
            image.hidden = false;
        }
    }

    window.setInterval(() => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
    }, 10_000);
</script>