<div id="message-sent-popup" class="fixed inset-0 z-10 bg-[rgb(112,122,233,0.75)] hidden justify-center items-center">
    <div class="w-screen flex flex-col items-center text-center">
        <span class="element-top-cm1">MESSAGE SENT</span>
        <span style="font-family: 'Kode Mono';" class="text-[2cqw]">Expect a reply within 1-3 days!</span>
        <!-- <div></div> -->
        <button id="sent-close-button" class="cut-corners w-[25%] mt-[2%] text-[2cqw]">CLOSE</button>
    </div>
</div>

<script>
    let submitted = false;
    const googleForm = document.getElementById('googleForm');
    const hiddenIframe = document.getElementById('hidden_iframe');
    const messagePopup = document.getElementById('message-sent-popup');
    const sentCloseButton = document.getElementById('sent-close-button');

    googleForm?.addEventListener('submit', () => {
        submitted = true;
    });

    hiddenIframe?.addEventListener('load', () => {
        if (submitted) {
            console.log('submitted');
            messagePopup?.classList.replace('hidden', 'flex');
            googleForm.reset();
        }
    });

    sentCloseButton?.addEventListener('click', () => {
        messagePopup?.classList.replace('flex', 'hidden');
    })
</script>